              "type": "object",
              "additionalProperties": false,
              "properties": {
                "top_k": {
                  "type": "integer",
                  "title": "每次注入条数",
                  "description": "每次对话最多选取的相关记忆数量。",
                  "minimum": 1,
                  "maximum": 20,
                  "default": 8
                },
                "max_context_chars": {
                  "type": "integer",
                  "title": "上下文字数上限",
