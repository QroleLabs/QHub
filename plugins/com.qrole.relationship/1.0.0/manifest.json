{
  "schema_version": "1",
  "id": "com.qrole.relationship",
  "name": "轻量关系状态",
  "version": "1.0.0",
  "description": "由用户主动维护当前 Persona、角色和剧情分支的称呼、熟悉与交流边界。",
  "category": "记忆与上下文",
  "keywords": ["关系", "称呼", "交流边界", "角色对话"],
  "author": {"name": "QScene"},
  "runtime": {"type": "relationship.v1"},
  "permissions": ["chat:relationship"],
  "compatibility": {"platform_api": ">=1.0.0 <2.0.0"},
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "max_context_chars": {
        "type": "integer",
        "title": "上下文字数上限",
        "description": "一次对话最多注入的关系状态参考信息。",
        "minimum": 200,
        "maximum": 4000,
        "default": 1200
      }
    }
  }
}
