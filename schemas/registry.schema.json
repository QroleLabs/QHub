{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/QroleLabs/QHub/main/schemas/registry.schema.json",
  "title": "QHub Plugin Registry",
  "type": "object",
  "required": ["schema_version", "name", "revision", "repository", "plugins"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1"},
    "name": {"const": "QHub"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 80},
    "repository": {"type": "string", "format": "uri", "maxLength": 2000},
    "plugins": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plugin": {
      "type": "object",
      "required": ["id", "trust", "listed", "repository_url", "releases"],
      "properties": {
        "id": {"$ref": "#/$defs/pluginId"},
        "trust": {"enum": ["official", "reviewed"]},
        "listed": {"type": "boolean"},
        "repository_url": {"type": "string", "format": "uri", "maxLength": 2000},
        "documentation_url": {"type": "string", "format": "uri", "maxLength": 2000},
        "releases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/release"}
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["version", "path", "manifest_hash", "published_at", "manifest"],
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "path": {
          "type": "string",
          "pattern": "^plugins/[a-z0-9][a-z0-9._-]*/[^/]+/manifest\\.json$"
        },
        "manifest_hash": {"$ref": "#/$defs/sha256"},
        "published_at": {"type": "string", "format": "date-time"},
        "manifest": {"$ref": "plugin-manifest.schema.json"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
