{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/QroleLabs/QHub/main/schemas/plugin-manifest.schema.json",
  "title": "QScene Plugin Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "runtime",
    "permissions"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1"},
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {"type": "string", "maxLength": 4000},
    "category": {"type": "string", "minLength": 1, "maxLength": 80},
    "keywords": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "author": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 160},
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 160},
            "url": {"type": "string", "format": "uri", "maxLength": 2000}
          },
          "additionalProperties": true
        }
      ]
    },
    "repository": {"type": "string", "format": "uri", "maxLength": 2000},
    "homepage": {"type": "string", "format": "uri", "maxLength": 2000},
    "documentation": {"type": "string", "format": "uri", "maxLength": 2000},
    "license": {"type": "string", "maxLength": 80},
    "runtime": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 80},
        "prompt": {"type": "string", "maxLength": 32000},
        "entrypoints": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["prompt", "prompt.v1"]}}},
          "then": {"required": ["prompt"]}
        }
      ],
      "additionalProperties": true
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._:-]*$"
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "platform_api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "default": ">=1.0.0 <2.0.0"
        }
      },
      "additionalProperties": true
    },
    "config_schema": {"$ref": "#/$defs/configSchema"},
    "entrypoints": {"type": "object"},
    "js": {},
    "css": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {"type": {"enum": ["prompt", "prompt.v1"]}},
            "required": ["type"]
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {"contains": {"const": "chat:context"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {"type": {"const": "memory.v1"}},
            "required": ["type"]
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {"contains": {"const": "chat:memory"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {"type": {"const": "model-preference.v1"}},
            "required": ["type"]
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {"contains": {"const": "chat:model-preference"}},
          "config_schema": {
            "required": ["properties", "required"],
            "properties": {
              "required": {"contains": {"const": "channel_model_id"}},
              "properties": {
                "required": ["channel_model_id"],
                "properties": {
                  "channel_model_id": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {"type": {"const": "string"}}
                  }
                }
              }
            }
          }
        },
        "required": ["config_schema"]
      }
    }
  ],
  "$defs": {
    "configSchema": {
      "type": "object",
      "properties": {
        "type": {"const": "object"},
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "additionalProperties": {"type": "boolean"},
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {"enum": ["string", "number", "integer", "boolean"]},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "default": {},
              "enum": {"type": "array", "minItems": 1, "maxItems": 50},
              "minLength": {"type": "integer", "minimum": 0},
              "maxLength": {"type": "integer", "minimum": 0},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "format": {"type": "string"},
              "writeOnly": {"type": "boolean"},
              "x-sensitive": {"type": "boolean"},
              "x-runtime-visible": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
